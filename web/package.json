{
  "name": "suresay-web",
  "private": true,
  "version": "1.4.0",
  "description": "SureSay web client: three big guesses, and nothing happens until you choose one. WCAG 2.2 AA; voice, tap, keys or one switch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prashant-thakur77/SureSay.git",
    "directory": "web"
  },
  "keywords": [
    "accessibility",
    "dysarthria",
    "voice-assistant",
    "mcp",
    "react",
    "aac"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.12"
  }
}
